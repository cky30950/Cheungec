rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 授權基礎
    // ------------------------------------------------------------
    // 主要機制：Firebase Auth Custom Claims（由 Pages Function 以
    // Service Account 寫入，客戶端無法自行竄改）：
    //   staff=true、active=true、admin=true、userId、clinicId、position
    //
    // 過渡 fallback：userAuthIndex 文件（供部署後一小時內、尚未刷新
    // ID Token 的舊工作階段使用）。所有用戶重新登入後可移除
    // isActiveByIndex / isAdminByIndex 及 canAccess/canAdmin 中的引用。
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Custom claims（主要）──
    function isActiveStaff() {
      return isSignedIn()
        && request.auth.token.staff == true
        && request.auth.token.active == true;
    }
    function isAdmin() {
      return isActiveStaff() && request.auth.token.admin == true;
    }

    // ── userAuthIndex 過渡 fallback ──
    function indexPath() {
      return /databases/$(database)/documents/userAuthIndex/$(request.auth.uid);
    }
    function staffIndex() {
      return get(indexPath()).data;
    }
    function isActiveByIndex() {
      return isSignedIn()
        && exists(indexPath())
        && staffIndex().active == true;
    }
    function isAdminByIndex() {
      return isActiveByIndex()
        && staffIndex().position == '診所管理';
    }

    function canAccess() {
      return isActiveStaff() || isActiveByIndex();
    }
    function canAdmin() {
      return isAdmin() || isAdminByIndex();
    }

    // 本人更新自己的 users 文件：只允許個人設定與登入時間，
    // 身份/權限欄位一律不得透過此路徑變更。
    function selfProfileUpdate() {
      return canAccess()
        && (request.auth.token.userId == resource.id
            || (exists(indexPath()) && staffIndex().userId == resource.id))
        && request.resource.data.position == resource.data.position
        && request.resource.data.active == resource.data.active
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.email == resource.data.email
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastLogin', 'personalSettings', 'updatedAt', 'updatedBy']);
    }

    // 錢包集合的員工讀取把關
    // 【暫時政策 2026-09】員工診所對應表尚未整理完成，過渡期內所有
    // 活躍員工均可讀全部診所的錢包資料。日後收回跨診所權限時，把此函式
    // 恢復為「帶 clinicId claim 者僅可讀 resource.data.clinicId 相符的
    // 文件、無 claim 超管可讀全部」的比對版本即可。
    // 注意：get 一個「不存在」的文件時 resource 為 null（員工探測病人
    // 是否已開戶屬正常路徑，snapshot 不含任何欄位，不構成外洩）。
    function walletStaffRead() {
      return resource == null || isActiveStaff() || isActiveByIndex();
    }

    // ============================================================
    // 公開（病人無登入）集合
    // ============================================================

    // inquiry 表單：客戶端一律不可寫入——匿名遞交只可經
    // POST /api/inquiry/submit（Turnstile 驗證後以 Service Account 寫入）；
    // 讀取/更新/刪除皆須職員身份。
    // （舊規則 allow create: if true，機械人可無限量偽造預診，已封閉）
    match /inquiries/{document=**} {
      allow create, update, delete: if false;
      allow read: if canAccess();
    }

    // 視訊診間雙方就緒信號：病人無登入，僅限 tcm-consult- 開頭的單一診間文件，
    // 且內容只能有 doctor / patient 兩個心跳欄位；不開放匿名列出整個集合或刪除
    match /videoPresence/{channelId} {
      allow get: if channelId.matches('tcm-consult-.{1,64}');
      allow create, update: if channelId.matches('tcm-consult-.{1,64}')
        && request.resource.data.keys().hasOnly(['doctor', 'patient']);
    }

    // 視像診症同意書：權威記錄只由 Pages Function 以 Service Account
    // 寫入（POST room-consent，須持有效入房 session），客戶端不可
    // create/update/delete——匿名 create 可用掛號號偽造同意記錄。
    // 匿名 get 同樣關閉（可用掛號號探測是否已看診、讀 userAgent）；
    // 僅員工可讀單一文件，供醫師端即時監聽簽署狀態。
    match /videoConsents/{channelId} {
      allow get: if canAccess();
      allow list, create, update, delete: if false;
    }

    // ============================================================
    // 身份與授權集合
    // ============================================================

    // 登入授權索引：客戶端只可讀自己的索引文件；
    // 寫入一律拒絕——索引只由 Pages Function 以 Service Account 維護
    match /userAuthIndex/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 授權用戶主資料
    //  - 讀取：活躍員工
    //  - 新增/刪除：管理員（診所管理）
    //  - 更新：管理員，或本人僅改個人設定/登入時間
    match /users/{userId} {
      allow read: if canAccess();
      allow create, delete: if canAdmin();
      allow update: if canAdmin() || selfProfileUpdate();
    }

    // ============================================================
    // 業務輔助集合
    // ============================================================

    // 病人清單變更通知 metadata
    match /patientsMeta/{document=**} {
      allow read, write: if canAccess();
    }

    // 收費項目（globalBillingItems／clinics/{id}/billingItems）
    // 跨裝置變更通知 metadata：單文件監聽，讀取量恆定
    match /billingItemsMeta/{document=**} {
      allow read, write: if canAccess();
    }

    // 備份記錄 metadata
    match /backupMeta/{document=**} {
      allow read, write: if canAccess();
    }

    // 系統級遷移狀態（如 consultations searchKeywords 回填完成旗標，
    // 旗標會關閉病歷搜尋的 legacy fallback）：員工可讀，僅管理員可寫
    match /systemMeta/{document=**} {
      allow read: if canAccess();
      allow write: if canAdmin();
    }

    // 病歷附件（R2）：
    // 新文件由 Pages Function 以 Service Account 經 REST 建立（繞過 Rules），
    // 客戶端不允許 create；刪除為伺服器端軟刪，客戶端不允許 delete。
    // 客戶端僅可 update：上傳完成 PATCH uploadStatus、保存診症後歸戶
    // （consultationId/sessionId/consultationDate），其餘欄位不可竄改。
    match /patientAttachments/{fileId} {
      allow read: if canAccess();
      allow update: if canAccess()
        && request.resource.data.fileId == resource.data.fileId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.uploadedByUid == resource.data.uploadedByUid
        && request.resource.data.originalKey == resource.data.originalKey
        && request.resource.data.thumbKey == resource.data.thumbKey
        && request.resource.data.category == resource.data.category
        && request.resource.data.deleted == false
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['uploadStatus', 'consultationId', 'sessionId',
                     'consultationDate', 'updatedAt']);
      allow create, delete: if false;
    }

    // 手機代拍 session：只由 Pages Function 以 Service Account 讀寫
    // （含 token hash、病人歸屬、過期時間），客戶端任何操作一律拒絕。
    // 手機端不登入，憑 sid+token 直接呼叫 Function 端點，不碰 Firestore。
    match /attachmentCaptureSessions/{sid} {
      allow read, write: if false;
    }

    // 視訊入房 pass：只由 Pages Function 以 Service Account 讀寫
    // （含 pass hash、綁定頻道、過期時間、consumed/revoked 狀態），客戶端
    // 任何操作一律拒絕。病人端不登入，連結 pass 走 fragment，經 POST
    // room-session（Function 端點）換發，全程不碰 Firestore。
    match /videoRoomPasses/{passId} {
      allow read, write: if false;
    }

    // 視訊入房 session：pass 換發後的短 TTL 憑證記錄（派生 uid、
    // 綁定頻道、active/revoked 狀態），同樣只由 Service Account 讀寫。
    match /videoRoomSessions/{sessionId} {
      allow read, write: if false;
    }

    // ============================================================
    // 會員儲值
    // ============================================================

    // 儲值帳戶（每診所獨立，文件 ID = {clinicId}__{patientId}）：
    //  - 僅活躍員工可讀（過渡期暫不做跨診所限制，見 walletStaffRead）
    //  - 寫入一律拒絕——所有進出均由 Pages Function 以 SA 交易處理，
    //    客戶端不可直接改餘額
    //  - 舊制全域帳戶（文件 ID = patientId）同適用本規則
    match /patientWalletAccounts/{accountId} {
      allow get, list: if walletStaffRead();
      allow write: if false;
    }

    // 錢包流水（只加不刪）：
    //  - 僅活躍員工可讀（過渡期暫不做跨診所限制，見 walletStaffRead）
    //  - 寫入一律拒絕，僅 SA 端點可建立
    match /patientWalletTransactions/{txId} {
      allow read: if walletStaffRead();
      allow write: if false;
    }

    // 冪等鍵記錄：完全由 SA 維護（防重複扣款），客戶端任何操作拒絕
    match /walletIdempotency/{keyId} {
      allow read, write: if false;
    }

    // 診症單退款累計（防重複／超額退款）：僅 SA 於退款交易內讀寫，
    // 客戶端任何操作拒絕；退款明細仍可由 patientWalletTransactions 查閱
    match /walletConsultationRefunds/{consultationId} {
      allow read, write: if false;
    }

    // 病人文件：僅員工可讀寫
    match /patients/{patientId} {
      allow read, write: if canAccess();
    }

    // 次數套票：僅員工可讀寫
    match /patientPackages/{packageId} {
      allow read, write: if canAccess();
    }

    // ============================================================
    // 個人統計
    // ------------------------------------------------------------
    // owner 身份為 Firebase Auth uid。客戶端唯讀「自己的」資料；
    // 所有寫入（增量同步、全量重建、刪除）只可經
    // /api/personal-stats/* 由 Pages Function 以 Service Account
    // 執行（繞過 Rules）。
    // ============================================================
    match /personalStatisticsMonthlySummaries/{docId} {
      allow read: if canAccess()
        && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /personalStatisticsSummaryStates/{ownerId} {
      allow read: if canAccess()
        && request.auth.uid == ownerId;
      allow write: if false;
    }

    // ============================================================
    // 財務日聚合
    // ------------------------------------------------------------
    // 每日每診所一筆聚合文件，客戶端唯讀（員工身份）；
    // 所有寫入（增量同步、全量重建、刪除）只可經
    // /api/financial-stats/* 由 Pages Function 以 Service Account 執行。
    // ============================================================
    match /dailyFinancialStats/{docId} {
      allow read: if canAccess();
      allow write: if false;
    }

    // ============================================================
    // Catch-all：其他業務集合（consultations、clinics、
    // clinicExpenses、globalBillingItems 等）。
    // 必須持有活躍員工身份（claims 或過渡索引）才可讀寫。
    // 注意：Firestore 多條 match 為聯集（OR），故所有上方專用集合
    // 都必須在此排除，否則這條規則會重新放寬它們。
    // ============================================================
    match /{collectionId}/{document=**} {
      allow read, write: if canAccess()
        && collectionId != 'patientAttachments'
        && collectionId != 'attachmentCaptureSessions'
        && collectionId != 'videoRoomPasses'
        && collectionId != 'videoRoomSessions'
        && collectionId != 'userAuthIndex'
        && collectionId != 'users'
        && collectionId != 'inquiries'
        && collectionId != 'videoPresence'
        && collectionId != 'videoConsents'
        && collectionId != 'patientsMeta'
        && collectionId != 'billingItemsMeta'
        && collectionId != 'backupMeta'
        && collectionId != 'patientWalletAccounts'
        && collectionId != 'patientWalletTransactions'
        && collectionId != 'walletIdempotency'
        && collectionId != 'walletConsultationRefunds'
        && collectionId != 'patients'
        && collectionId != 'patientPackages'
        && collectionId != 'personalStatisticsMonthlySummaries'
        && collectionId != 'personalStatisticsSummaryStates'
        && collectionId != 'dailyFinancialStats';
    }
  }
}
